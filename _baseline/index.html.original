    <div class="card">
      <div class="card-header">
        <div>
          <div class="card-company">Comexi</div>
          <div class="card-role">Desarrollador Web Full Stack & SAP · Riudellots de la Selva</div>
        </div>
        <span class="card-date">Oct 2023 — Oct 2025</span>
      </div>
      <ul>
        <li>Desarrollo fullstack con Laravel, Vue3, SAPUI5, Python y C#</li>
        <li>Aplicaciones con Google AppSheet y chatbots con IA integrada</li>
        <li>1 año con SAP R/3 v740, participando en migración a S/4HANA</li>
        <li>Tutor en programa DUAL de 1.000 horas</li>
      </ul>
    </div>

    <div class="card">
      <div class="card-header">
        <div>
          <div class="card-company">Cocinero Profesional</div>
          <div class="card-role">Varios establecimientos · Girona y alrededores</div>
        </div>
        <span class="card-date">2013 — 2022</span>
      </div>
      <ul>
        <li>9 años de trayectoria en hostelería profesional</li>
        <li>Estudios de cocina finalizados con las mejores notas de Girona</li>
      </ul>
    </div>
  </section>

  <div class="divider"></div>

  <!-- SKILLS -->
  <section class="section" id="skills">
    <div class="section-label">Stack</div>
    <div class="section-title">Tecnologías</div>

    <div class="skills-grid">
      <div class="skill-group">
        <div class="skill-group-label">Lenguajes</div>
        <div class="skill-tags">
          <span class="tag">JavaScript</span>
          <span class="tag">PHP</span>
          <span class="tag">Python</span>
          <span class="tag">SQL</span>
