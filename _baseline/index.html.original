          <span class="tag">ABAP</span>
        </div>
      </div>
      <div class="skill-group">
        <div class="skill-group-label">Frameworks</div>
        <div class="skill-tags">
          <span class="tag">Laravel</span>
          <span class="tag">React</span>
          <span class="tag">Vue 3</span>
          <span class="tag">SAPUI5</span>
          <span class="tag">WPF .NET</span>
        </div>
      </div>
      <div class="skill-group">
        <div class="skill-group-label">SAP</div>
        <div class="skill-tags">
          <span class="tag">ECC 6.0</span>
          <span class="tag">S/4HANA</span>
          <span class="tag">BASIS 731</span>
          <span class="tag">R/3 v740</span>
        </div>
      </div>
      <div class="skill-group">
        <div class="skill-group-label">IA & LLM</div>
        <div class="skill-tags">
          <span class="tag">OpenWebUI</span>
          <span class="tag">MCP Servers</span>
          <span class="tag">Embeddings</span>
          <span class="tag">Chatbots</span>
